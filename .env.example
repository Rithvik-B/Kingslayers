# Copy to .env and fill in. Never commit .env. Real values are shared privately, never in git or chat.
# NEVER set ANTHROPIC_API_KEY here: it overrides the Claude Max login the app uses (see PLAN.md §1).
CRUSTDATA_API_KEY=
CRUSTDATA_API_VERSION=2025-11-01
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=
SELLER_EMAIL=
SELLER_NAME=Kingslayers Demo
STAND_IN_EMAIL=
LLM_BACKEND=agent_sdk
LLM_MODEL=sonnet
BACKUP_ANTHROPIC_API_KEY=
BACKUP_ANTHROPIC_MODEL=claude-sonnet-5-5
DEMO_MODE=true
OUTBOUND_ENABLED=false
TIMEZONE=Asia/Kolkata
DISCOVERY_COMPANY_LIMIT=5
CONTACTS_PER_COMPANY=1
CREDIT_CEILING_PER_RUN=150
ACCEPTED_EMAIL_STATUSES=deliverable,catch_all
